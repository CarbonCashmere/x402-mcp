# Copy this file to .env and fill in your wallet keys.
# At least one of EVM_PRIVATE_KEY or SVM_PRIVATE_KEY MUST be set.

# 0x-prefixed EVM private key (Base / Polygon / Arbitrum payments).
# Generate one with: `python -c "import secrets; print('0x'+secrets.token_hex(32))"`
# Fund with USDC on Base mainnet for cheapest payments.
EVM_PRIVATE_KEY=

# base58-encoded Solana keypair (optional; needed only for Solana-only tools)
SVM_PRIVATE_KEY=

# Optional overrides
X402_API_BASE=https://api.carbon-cashmere.de
X402_TOOL_LIMIT=50
X402_LOG_LEVEL=info
